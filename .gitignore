# Secrets: keys live in .env only (CLAUDE.md hard rules)
.env
.env.*
!.env.example

# Python and uv (uv.lock IS committed)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Local caches (bake-off responses, model outputs)
.cache/

# Node (only if someone installs JS tooling; the app itself is Python)
node_modules/

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# Video and frames from a real home never go in git.
# Staged fixture frames of our own objects (tests/fixtures/frames/) are committed.
recordings/
*.mp4
*.mov
*.m4v
*.webm
tests/fixtures/frames/private/
# Full-size originals of the staged fixtures: 24 MP each, with GPS in their EXIF. The
# committed frames are 1920 px copies with no metadata (step 04).
tests/fixtures/frames/originals/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code personal settings
.claude/settings.local.json
