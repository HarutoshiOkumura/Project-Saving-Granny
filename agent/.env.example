# The FaceTime agent's settings (agent/ only). Copy to .env.local, chmod 600, fill in privately, never commit.
# The backend has its own file: the repo root .env (template ../.env.example). env.mjs makes this file win over
# variables the terminal already has, so nothing in the root .env can redirect the agent.

# All three LiveKit values must belong to one project. If the root .env also has LIVEKIT_*, keep them identical.
# On a Shared plan with Chert rooms, leave all three empty (LIVEKIT_URL=): calls then run in Chert's LiveKit.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Gemini Live is the agent's voice (D23): a Google AI key with Gemini API access.
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# The name the agent registers with. chert dev and chert doctor read it from .env.local (run them with --agent save-it).
AGENT_NAME=save-it

# Our backend's find API (app/main.py). Empty: answers come from the fake home (fake-home.mjs).
BACKEND_URL=http://localhost:8000
# Sent as "Authorization: Bearer ..." once /find checks a token; empty until then.
APP_TOKEN=
# The family member the agent offers to call.
FAMILY_NAME=June

# Optional. Keep a 2.5 native-audio model: "3.1" models break the greeting in plugin 1.8.0 (D23).
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_VOICE=Aoede

# Testing only: also write what was heard and said to logs/calls.jsonl (gitignored). Leave off for real use.
# LOG_TRANSCRIPTS=1
# Experiment: may stop Gemini thinking before it answers (not confirmed for this model). Compare ttft_ms in the log.
# GEMINI_THINKING_BUDGET=0
