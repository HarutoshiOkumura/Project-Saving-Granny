# Copy to .env and fill in. Never commit .env.
# These names are what app/config.py reads.
# Keep comments on their own lines; values have no quotes.

# ---------- Supabase (docs/SUPABASE.md) ----------
SUPABASE_URL=
# Publishable key (sb_publishable_...): low privilege, safe in a browser. The backend does not need it.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): bypasses row level security. Backend only. Never in app/web/.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Postgres connection string from Dashboard > Connect, for psql only. Optional.
DATABASE_URL=
# Fixed in supabase/seed.example.sql
HOME_ID=11111111-1111-1111-1111-111111111111

# ---------- Backend ----------
# Public HTTPS address of the API, used by Vapi and the phone camera page (D5)
PUBLIC_BASE_URL=
# Shared secret the capture page and dashboard send to the backend. Not a Supabase key. Step 07 sets it.
APP_TOKEN=

# ---------- Claude API (perception) ----------
ANTHROPIC_API_KEY=
PERCEPTION_MODEL=claude-haiku-5-5

# ---------- Roboflow (docs/ROBOFLOW.md) ----------
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://serverless.roboflow.com
# <project>/<version> once a model is trained (step 04)
ROBOFLOW_MODEL_ID=

# ---------- Vapi (step 03) ----------
# Secret Vapi sends with each tool call so /vapi/tool can reject strangers.
# How it is sent: check the Vapi docs in step 03.
VAPI_SERVER_SECRET=

# ---------- LiveKit and Chert (step 10, optional) ----------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------- Typesense (step 09, optional) ----------
TYPESENSE_HOST=
TYPESENSE_API_KEY=
