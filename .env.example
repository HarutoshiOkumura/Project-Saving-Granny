# Copy to .env and fill in. Never commit .env.
# These names are what app/config.py reads.
# Keep comments on their own lines; values have no quotes.

# ---------- Supabase (docs/SUPABASE.md) ----------
SUPABASE_URL=
# Publishable key (sb_publishable_...): low privilege, safe in a browser. The backend does not need it.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): bypasses row level security. Backend only. Never in app/web/.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Postgres connection string from Dashboard > Connect, for psql only. Optional.
DATABASE_URL=
# Fixed in supabase/seed.example.sql
HOME_ID=11111111-1111-1111-1111-111111111111

# ---------- Backend ----------
# Public HTTPS address of the API, used by Vapi and the phone camera page (D5)
PUBLIC_BASE_URL=
# Shared secret the capture page and dashboard send to the backend. Not a Supabase key. Step 07 sets it.
APP_TOKEN=

# ---------- Gemini API (perception, D24) ----------
# Key from Google AI Studio. Before real camera frames, link a billing account to its project and turn
# logging off in AI Studio (Logs and Datasets): on the free tier Google may use inputs, images included,
# to improve its products, with human review; on paid projects logging is on by default (55 days).
GOOGLE_API_KEY=
PERCEPTION_MODEL=gemini-3.6-flash

# ---------- Roboflow (docs/ROBOFLOW.md) ----------
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://serverless.roboflow.com
# <project>/<version> once a model is trained (step 04)
ROBOFLOW_MODEL_ID=

# ---------- Perception thresholds (D11) ----------
# Leave empty for the defaults in .claude/rules/perception.md (tuned in step 05).
# Frame dropped when room_confidence is below ROOM_CUT; item dropped below ITEM_CUT.
ROOM_CUT=
ITEM_CUT=
# Any demo item at or above this SAM 3 score sends the frame on to Gemini (D3).
SAM3_GATE=
# Hard stop per attempt, in seconds (3 retries with backoff after that).
PERCEPTION_TIMEOUT_S=
DETECTOR_TIMEOUT_S=

# ---------- Ingest worker (step 06, D10, D11) ----------
# Leave empty for the defaults. Frames below BLUR_CUT (variance of the Laplacian) are dropped, and
# frames at or above DUPLICATE_CUT (SSIM) against the last accepted one, unless that one is older
# than DUPLICATE_REFRESH_S seconds.
BLUR_CUT=
DUPLICATE_CUT=
DUPLICATE_REFRESH_S=
# Seconds between Gemini looks when SAM 3 sees no item (they feed mark_absent).
EMPTY_LOOK_EVERY_S=
# Gemini calls in flight at most; a frame arriving when all are busy is dropped.
VLM_IN_FLIGHT=

# ---------- Vapi (step 03) ----------
# Secret Vapi sends with each tool call so /vapi/tool can reject strangers.
# How it is sent: check the Vapi docs in step 03.
VAPI_SERVER_SECRET=

# ---------- LiveKit and Chert (step 10, optional) ----------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------- Typesense (step 09, optional) ----------
# Leave empty to turn name matching off. Local: http://localhost:8108 (docs/STATUS.md, step 09)
TYPESENSE_HOST=
TYPESENSE_API_KEY=
